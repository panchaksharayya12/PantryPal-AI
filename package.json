{
  "name": "pantrypal-ai",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "vite",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:api": "esbuild server/apiHandler.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/index.js --external:sqlite3 --external:sqlite",
    "build": "npm run build:api && npm run build:client",
    "start": "tsx server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "PantryPal AI - Your kitchen. Your ingredients. Endless possibilities.",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "multer": "^2.4.0",
    "openai": "^6.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  }
}
